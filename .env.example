# Copy to `.env` locally. Only variables prefixed with REACT_APP_ are exposed to the client.
# https://create-react-app.dev/docs/adding-custom-environment-variables/
REACT_APP_API_BASE_URL=https://predev.tradeharmonizer.co.uk
REACT_APP_APP_NAME=Recovery Platform
REACT_APP_MAIN_SITE_URL=https://recovery.tradeharmonizer.co.uk/login
REACT_APP_TENANT_VALIDATE_PATH=/tenants/validate
REACT_APP_RECOVERY_TENANT_VALIDATE_PATH=/recovery/tenants/validate

# Firebase Cloud Messaging — same Firebase project as trade-harmonizer's frontend; copy
# the values from trade-harmonizer/.env. Optional: leave unset to skip real-time push
# (the Imports page falls back to its safety-net poll only).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_VAPID_KEY=
