{
  "name": "recovery-platform",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "craco start",
    "dev": "craco start",
    "verify": "node scripts/verify-build-report.mjs",
    "prebuild": "npm run verify",
    "build": "cross-env GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false craco build",
    "typecheck": "tsc --noEmit",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:audit": "node scripts/audit-hardcoded-text.mjs",
    "i18n:audit:strict": "node scripts/audit-hardcoded-text.mjs --fail-on-findings",
    "i18n:baseline:update": "node scripts/audit-hardcoded-text.mjs --update-baseline",
    "test:ci": "cross-env CI=true craco test --watchAll=false",
    "security:trivy": "sh scripts/trivy-fs.sh",
    "trivy:scan": "trivy fs --config trivy.yaml --scanners vuln,secret --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL .",
    "security:audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react-csv": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-csv": "^2.2.2",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-paginate": "^8.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.2",
    "react-select-country-list": "^2.2.3",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^2.6.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-select-country-list": "^2.2.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "nth-check": "^2.1.1",
    "serialize-javascript": "^7.0.0",
    "shell-quote": "^1.8.4",
    "underscore": "^1.13.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
